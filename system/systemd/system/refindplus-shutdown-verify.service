[Unit]
Description=Verify EFI loaders on the ESP before shutdown
Documentation=file:///usr/local/sbin/refindplus-assert-bootorder
DefaultDependencies=no
After=local-fs.target
Before=shutdown.target umount.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/sbin/refindplus-assert-bootorder
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
