# --- linux_setup additions ---

# Non-interactive shells (scp/rsync/scripts) — exit before any side effects
case $- in
    *i*) ;;
    *) return;;
esac

# History — dedupe, append across terminals, sane sizes
HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s checkwinsize

# Standard user-extension hook
[ -f ~/.bash_aliases ] && . ~/.bash_aliases

alias docker="podman"
alias reboot='sudo systemctl reboot'
alias poweroff='sudo systemctl poweroff'
alias suspend='gtklock & sleep 1 && sudo systemctl suspend'
alias rm='rm -I'
alias ark='sudo /usr/local/bin/ark'
alias rfkill='/usr/sbin/rfkill'

# Tab completion: cycle through matches inline (no list break)
[[ $- == *i* ]] && bind 'TAB:menu-complete'

if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ] && [ "${XDG_VTNR:-}" -eq 1 ]; then
    exec sway
fi

# zed
export PATH=$HOME/.local/bin:$PATH
# go
export PATH=$HOME/go/bin:$PATH
# cargo (wayland-pipewire-idle-inhibit, etc.)
export PATH=$HOME/.cargo/bin:$PATH

# fzf — key bindings and completion
[ -f /usr/share/doc/fzf/examples/key-bindings.bash ] && source /usr/share/doc/fzf/examples/key-bindings.bash
[ -f /usr/share/doc/fzf/examples/completion.bash ] && source /usr/share/doc/fzf/examples/completion.bash
# fzf — custom env (fd backend, dotfiles hidden)
[ -f ~/.config/fzf/env.sh ] && source ~/.config/fzf/env.sh

# Internet network namespace
# wrapper script in tools/opencode.sh handles opencode
alias podman-pull='sudo enter-internet-netns /usr/bin/podman pull'

# gtr — git worktree manager for AI panels
# g <branch>      switch to worktree (create if needed); Zed replaces current window's workspace
# g <verb> ...    forward to git gtr (rm, list, go, editor, ai, config, clean, copy, mv, run)
# g cd            shell-integration worktree picker
_g_new() {
    local branch="${1:-}"
    if [ -z "$branch" ]; then
        echo "usage: g <branch>" >&2
        return 1
    fi
    local wt
    if ! wt="$(git gtr go "$branch" 2>/dev/null)"; then
        git gtr new "$branch" --from-current || return 1
        wt="$(git gtr go "$branch")" || return 1
    fi
    echo "Switched to: $wt"
    echo "Start opencode: Ctrl+\` in the switched window, then: opencode"
    zed -r "$wt" >/dev/null 2>&1 &
}
g() {
    case "$1" in
        cd) gtr "$@" ;;
        new) shift; _g_new "$@" ;;
        rm|list|go|editor|ai|config|clean|copy|mv|run) git gtr "$@" ;;
        *) _g_new "$1" ;;
    esac
}

# gtr — shell integration (tab completion, gtr cd)
_gtr_init="${XDG_CACHE_HOME:-$HOME/.cache}/gtr/init-gtr.bash"
[[ -f "$_gtr_init" ]] || eval "$(git gtr init bash)" || true
source "$_gtr_init" 2>/dev/null || true; unset _gtr_init

# Bash completion — distro default sources this in ~/.bashrc;
# guarded fallback in case that file is absent
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# Starship prompt
eval "$(starship init bash)"

# Fastfetch — system info on every new terminal window
fastfetch
