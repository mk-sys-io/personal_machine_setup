# --- linux_setup additions ---

# Non-interactive shells (scp/rsync/scripts) — exit before any side effects
case $- in
    *i*) ;;
    *) return;;
esac

# History — dedupe, append across terminals, sane sizes
HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s checkwinsize

# Standard user-extension hook
[ -f ~/.bash_aliases ] && . ~/.bash_aliases

alias docker="podman"
alias reboot='sudo systemctl reboot'
alias poweroff='sudo systemctl poweroff'
alias suspend='gtklock & sleep 1 && sudo systemctl suspend'
alias rm='rm -I'
alias ark='sudo /usr/local/bin/ark'
alias netmgr='sudo /usr/local/bin/netmgr'
alias rfkill='/usr/sbin/rfkill'
alias lc="!! | wl-copy"
# Tab completion: cycle through matches inline (no list break)
[[ $- == *i* ]] && bind 'TAB:menu-complete'

if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ] && [ "${XDG_VTNR:-}" -eq 1 ]; then
    exec sway
fi

# zed
export PATH=$HOME/.local/bin:$PATH
# go
export PATH=$HOME/go/bin:$PATH
# cargo (wayland-pipewire-idle-inhibit, etc.)
export PATH=$HOME/.cargo/bin:$PATH

# opencode (raw binary — shim via /usr/local/bin/opencode; uncomment only if
# the shim is unavailable and you accept the ergonomics trade-off)
# export PATH="$HOME/.opencode/bin:$PATH"

# /usr/local/bin guard — LAST prepend so system shims (inet, opencode, netmgr)
# win over the ~/.local/go/cargo prepends above
export PATH=/usr/local/bin:$PATH

# gitleaks — machine-wide shared config (deployed by `make dev` from
# dev/git/gitleaks.toml). Belt-and-braces beside the hook's -c flag:
# covers hand-run `gitleaks protect` invocations. Same file, same policy.
export GITLEAKS_CONFIG="$HOME/.config/gitleaks/gitleaks.toml"

# fzf — key bindings and completion
[ -f /usr/share/doc/fzf/examples/key-bindings.bash ] && source /usr/share/doc/fzf/examples/key-bindings.bash
[ -f /usr/share/doc/fzf/examples/completion.bash ] && source /usr/share/doc/fzf/examples/completion.bash
# fzf — custom env (fd backend, dotfiles hidden)
[ -f ~/.config/fzf/env.sh ] && source ~/.config/fzf/env.sh

# Bash completion — distro default sources this in ~/.bashrc;
# guarded fallback in case that file is absent
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# Starship prompt
eval "$(starship init bash)"

# Fastfetch — system info on every new terminal window
fastfetch

# XDG base dirs (30-C; systemd environment.d covers GUI, this covers shells)
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
