{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": ["sway/workspaces", "custom/sep", "custom/music", "group/music"],
    "modules-center": ["clock#date", "custom/sep", "clock#time"],
    "modules-right": ["custom/menu", "custom/sep", "custom/hw-mon", "custom/sep", "pulseaudio", "custom/sep", "backlight", "custom/sep", "network", "custom/sep", "battery", "custom/sep", "custom/numlock", "custom/notification", "tray"],

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "custom/music": {
        "format": "󰎈",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/music-picker.py"
    },

    "custom/music-status": {
        "exec": "~/.config/waybar/scripts/music-status.py",
        "return-type": "json",
        "format": "{text}",
        "tooltip": false,
        "on-click": "playerctl --player=mpv play-pause",
        "on-scroll-up": "playerctl --player=mpv position 5",
        "on-scroll-down": "playerctl --player=mpv position -5"
    },

    "group/music": {
        "orientation": "horizontal",
        "modules": [
            "custom/music-prev",
            "custom/music-status",
            "custom/music-next",
            "custom/music-close"
        ]
    },

    "custom/music-prev": {
        "exec": "~/.config/waybar/scripts/music-btn.py prev",
        "return-type": "json",
        "format": "{text}",
        "interval": 1,
        "tooltip": false,
        "on-click": "playerctl --player=mpv previous"
    },

    "custom/music-next": {
        "exec": "~/.config/waybar/scripts/music-btn.py next",
        "return-type": "json",
        "format": "{text}",
        "interval": 1,
        "tooltip": false,
        "on-click": "playerctl --player=mpv next"
    },

    "custom/music-close": {
        "exec": "~/.config/waybar/scripts/music-btn.py close",
        "return-type": "json",
        "format": "{text}",
        "interval": 1,
        "tooltip": false,
        "on-click": "playerctl --player=mpv stop"
    },

    "custom/sep": {
        "format": "|",
        "tooltip": false
    },

    "tray": {
        "spacing": 8,
        "icon-size": 16,
        "show-passive-items": true
    },

    "clock#date": {
        "format": "{:%a %b %d}",
        "tooltip": false
    },

    "clock#time": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%Y-%m-%d %I:%M:%S %p}",
        "tooltip-format": "<b>{:%A, %B %d, %Y}</b>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#d0d7de'><b>{}</b></span>",
                "days": "<span color='#d0d7de'>{}</span>",
                "weekdays": "<span color='#D29922'><b>{}</b></span>",
                "today": "<span color='#539bf5'><b><u>{}</u></b></span>"
            }
        }
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 1,
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{capacity}% | Health: {health}"
    },

    "network": {
        "format-wifi": "<span color='#D29922'>󰤨</span> {essid}",
        "format-ethernet": "<span color='#D29922'>󰈀</span> {ipaddr}",
        "format-disconnected": "<span color='#D29922'>󰤭</span> disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "~/.config/waybar/scripts/toggle-wifitui.sh",
        "interval": 5
    },

    "pulseaudio": {
        "format": "<span color='#D29922'>󰕾</span> {volume}%",
        "format-muted": "󰖁 muted",
        "tooltip": false,
        "on-click": "pavucontrol"
    },

    "backlight": {
        "format": "<span color='#D29922'>{icon}</span> {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip": false
    },

    "custom/numlock": {
        "exec": "~/.config/waybar/scripts/numlock.sh",
        "return-type": "json",
        "interval": 1,
        "tooltip": false
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='#D29922'>󰂚</span>",
            "none": "<span foreground='#d0d7de'>󰂚</span>",
            "dnd-notification": "<span foreground='#D29922'>󰂛</span>",
            "dnd-none": "<span foreground='#d0d7de'>󰂛</span>",
            "inhibited-notification": "<span foreground='#D29922'>󰂚</span>",
            "inhibited-none": "<span foreground='#d0d7de'>󰂚</span>",
            "dnd-inhibited-notification": "<span foreground='#D29922'>󰂛</span>",
            "dnd-inhibited-none": "<span foreground='#d0d7de'>󰂛</span>"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb --skip-wait",
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d -sw",
        "escape": true,
        "restart-interval": 3
    },

    "custom/menu": {
        "format": "󰍜",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/system-menu.sh"
    },

    "custom/hw-mon": {
        "exec": "~/.config/waybar/scripts/hwmon.py hw-mon",
        "return-type": "json",
        "interval": 5,
        "format": "{text}",
        "tooltip": true,
        "on-click": "kitty -e btop"
    }
}
