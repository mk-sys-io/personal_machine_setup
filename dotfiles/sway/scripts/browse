#!/bin/bash

# rofi-themed browser launcher over managed bookmarks.
# Reads ~/.local/share/bookmarks.html (generated by bookmarks.py during
# install.sh) and launches the selection in LibreWolf.
#   browse        -> picker over managed bookmarks
#   browse -u     -> type-a-URL mode (launch arbitrary URL)

BOOKMARKS_FILE="$HOME/.local/share/bookmarks.html"
ROFI_THEME="$HOME/.config/sway/rofi/browse.rasi"

# Extract "<a href="URL">Name</a>" pairs from the HTML into "Name<TAB>URL" lines.
read_bookmarks() {
    grep -o '<a href="[^"]*">[^<]*</a>' "$BOOKMARKS_FILE" 2>/dev/null \
        | sed -E 's|<a href="([^"]*)">([^<]*)</a>|\2\t\1|'
}

launch() {
    local url="$1"
    case "$url" in
        http://*|https://*) ;;
        *) url="https://$url" ;;
    esac
    exec librewolf "$url"
}

if [[ "${1:-}" == "-u" ]]; then
    url=$(rofi -dmenu -p "URL" -theme "$ROFI_THEME")
    [[ -n "$url" ]] && launch "$url"
    exit 0
fi

if [[ -z "${ROFI_RETV:-}" ]]; then
    exec rofi -modes "browse:$0" -show browse -theme "$ROFI_THEME"
fi

case "$ROFI_RETV" in
    0)
        printf '\0no-custom\x1ftrue\n'
        printf '\0keep-selection\x1ftrue\n'
        while IFS=$'\t' read -r name url; do
            [[ -n "$name" ]] && printf '%s\0info\x1f%s\n' "$name" "$url"
        done < <(read_bookmarks)
        ;;
    1)
        launch "${ROFI_INFO:-}"
        ;;
    *) exit 0 ;;
esac
