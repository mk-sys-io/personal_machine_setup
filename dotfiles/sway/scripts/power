#!/bin/bash

# Power menu for sway using rofi.
#
# Requirements:
# - rofi
# - gtklock
# - systemd
#
# Usage: power.sh
#
# Shutdown/Reboot path (verified 2026-10-13, do not "simplify"): calls
# graceful-close.sh DIRECTLY — no systemd-inhibit wrapper (logind denies
# Inhibit() box-wide; login1.inhibit isn't even a polkit action) and no
# loginctl attempt (CanReboot=no despite active session — deny rule in the
# unreadable /etc/polkit-1/rules.d/). The final power action rides the Ark
# POWER NOPASSWD allowlist (etc/ark/sudoers.d/00-base) via sudo systemctl.

ROFI_THEME="$HOME/.config/sway/rofi/power.rasi"

confirm_action() {
    local action="$1"
    chosen=$(printf '%s\n' "[No]" "Yes" | \
        rofi -dmenu -i -p "$action?" -theme "$ROFI_THEME")
    [[ "$chosen" == "Yes" ]]
}

chosen=$(printf '%s\n' "Lock" "[Cancel]" "Logout" "Suspend" "Shutdown" "Reboot" | \
    rofi -dmenu -i -p "Power Menu" -theme "$ROFI_THEME")

case "$chosen" in
    "Lock") gtklock ;;
    "Logout") confirm_action "Logout" && pkill sway ;;
    "Suspend") confirm_action "Suspend" && { gtklock & sleep 1 && sudo systemctl suspend; } ;;
    "Shutdown") confirm_action "Shutdown" && "$HOME/.config/sway/scripts/graceful-close.sh" poweroff ;;
    "Reboot") confirm_action "Reboot" && "$HOME/.config/sway/scripts/graceful-close.sh" reboot ;;
    *) exit 0 ;;
esac
