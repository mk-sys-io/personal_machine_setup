#!/bin/bash

# Power menu for sway using rofi.
#
# Requirements:
# - rofi
# - gtklock
# - systemd
#
# Usage: power.sh

ROFI_THEME="$HOME/.config/sway/rofi/power.rasi"

confirm_action() {
    local action="$1"
    chosen=$(printf '%s\n' "[No]" "Yes" | \
        rofi -dmenu -i -p "$action?" -theme "$ROFI_THEME")
    [[ "$chosen" == "Yes" ]]
}

chosen=$(printf '%s\n' "Lock" "[Cancel]" "Logout" "Suspend" "Shutdown" "Reboot" | \
    rofi -dmenu -i -p "Power Menu" -theme "$ROFI_THEME")

case "$chosen" in
    "Lock") gtklock ;;
    "Logout") confirm_action "Logout" && pkill sway ;;
    "Suspend") confirm_action "Suspend" && { gtklock & sleep 1 && sudo systemctl suspend; } ;;
    "Shutdown") confirm_action "Shutdown" && sudo systemctl poweroff ;;
    "Reboot") confirm_action "Reboot" && sudo systemctl reboot ;;
    *) exit 0 ;;
esac
