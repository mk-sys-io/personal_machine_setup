#!/bin/bash

# Text snippets picker for sway using rofi (script mode).
# Routing is driven by ROFI_INFO only (see man rofi-script):
#   ROFI_RETV=0           -> list snippet titles, each carrying \0info\x1f<index>
#   ROFI_RETV=1, info=edit -> Enter on "✏️ Edit snippets file": open editor, rofi quits
#   ROFI_RETV=1, info=<N> -> Enter on a title: show snippet preview + buttons
#   ROFI_RETV=1, info=copy:<N> -> Enter on "Copy to clipboard": copy, rofi quits
#   ROFI_RETV=1, info=0   -> Enter on "Back to list": return to title list

SNIPPETS_FILE="$HOME/.config/sway/snippets.txt"
ROFI_THEME="$HOME/.config/sway/rofi/snippets.rasi"

mapfile -d '' -t SNIPPETS < <(awk 'BEGIN { RS = ""; ORS = "\0" } { print }' "$SNIPPETS_FILE")

get_title() { printf '%s' "${SNIPPETS[$1]%%$'\n'*}"; }

list_titles() {
    printf '\0no-custom\x1ftrue\n'
    printf '\0keep-selection\x1ftrue\n'
    printf '\0new-selection\x1f1\n'
    printf '✏️ Edit snippets file\0info\x1fedit\n'
    for (( i = 0; i < ${#SNIPPETS[@]}; i++ )); do
        printf '📋 %s\0info\x1f%d\n' "$(get_title "$i")" "$(( i + 1 ))"
    done
}

edit_snippets_file() {
    setsid kitty --class floating-editor -o remember_window_size=no -o initial_window_width=80c -o initial_window_height=25c -e nano "$SNIPPETS_FILE" </dev/null >/dev/null 2>&1 &
    exit 0
}

copy_snippet() {
    printf '%s' "${SNIPPETS[$(( $1 - 1 ))]}" | wl-copy --trim-newline
    notify-send -a "snippets" -e -u low -t 3000 "📋 Snippet copied"
    exit 0
}

show_preview() {
    local idx="$1"
    local line count=0
    printf '\0no-custom\x1ftrue\n'
    while IFS= read -r line; do
        count=$((count + 1))
    done <<< "${SNIPPETS[$idx]}"
    printf '\0urgent\x1f%d\n' "$count"
    printf '\0active\x1f%d\n' "$(( count + 1 ))"
    printf '\0keep-selection\x1ftrue\n'
    printf '\0new-selection\x1f%d\n' "$count"
    while IFS= read -r line; do
        printf '%s\0nonselectable\x1ftrue\n' "$line"
    done <<< "${SNIPPETS[$idx]}"
    printf '📋 Copy to clipboard\0info\x1fcopy:%d\n' "$(( idx + 1 ))"
    printf '⬅ Back to list\0info\x1f0\n'
}

if [[ -z "${ROFI_RETV:-}" ]]; then
    exec rofi -modes "snippets:$0" -show snippets -theme "$ROFI_THEME"
fi

case "$ROFI_RETV" in
    0) list_titles ;;
    1)
       case "${ROFI_INFO:-}" in
           0)      list_titles ;;
           edit)   edit_snippets_file ;;
           copy:*) copy_snippet "${ROFI_INFO#copy:}" ;;
           *)      show_preview "$(( ${ROFI_INFO:-1} - 1 ))" ;;
       esac ;;
    *) exit 0 ;;
esac
