#!/bin/bash

function get_icon() {
	# Adwaita only ships display-brightness-symbolic (no low/medium/high tiers)
	echo "display-brightness-symbolic"
}

function make_bar() {
	local pct=$1
	local filled=$((pct * 2 / 5))
	local empty=$((40 - filled))
	local bar=""
	for ((i = 0; i < filled; i++)); do bar+="█"; done
	for ((i = 0; i < empty; i++)); do bar+="░"; done
	echo "$bar"
}

function get_pct() {
	local current=$(brightnessctl get 2>/dev/null)
	local max=$(brightnessctl max 2>/dev/null)
	if [[ -n "$current" && -n "$max" && "$max" -gt 0 ]]; then
		echo $((current * 100 / max))
	else
		echo 0
	fi
}

function send_notification() {
	local pct=$(get_pct)
	local icon=$(get_icon "$pct")
	local bar=$(make_bar "$pct")
	notify-send -a "changebrightness" -u low \
		-h string:x-canonical-private-synchronous:brightness \
		-h int:value:"$pct" \
		-i "$icon" \
		"Brightness ${pct}%" \
		"$bar" \
		-t 2000
}

case $1 in
	up)
		pct=$(get_pct)
		if [ "$pct" -lt 15 ]; then step=1; else step=5; fi
		brightnessctl set +${step}%
		send_notification
		;;
	down)
		pct=$(get_pct)
		if [ "$pct" -le 15 ]; then step=1; else step=5; fi
		new=$((pct - step))
		[ "$new" -lt 1 ] && new=1
		[ "$new" -eq "$pct" ] && exit 0
		brightnessctl set "${new}%"
		send_notification
		;;
	max)
		pct=$(get_pct)
		[ "$pct" -ge 100 ] && exit 0
		brightnessctl set 100%
		send_notification
		;;
	min)
		pct=$(get_pct)
		[ "$pct" -eq 1 ] && exit 0
		brightnessctl set 1%
		send_notification
		;;
esac
