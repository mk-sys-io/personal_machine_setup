{
  // DEPLOY NOTE: source only, not live. Edits require `make dev`
  // + manual opencode restart. Do not verify by running opencode here.
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "default_agent": "plan",
  // Compaction is manual-only (/compact): the session model has a 1M window but
  // agent.compaction.model is 262K, so auto-firing near 1.03M tokens would overflow it.
  // Accepted: compaction fails past ~258K tokens of history — /compact before then.
  "compaction": {
    "auto": true
  },
  // /tmp lockdown: file tools (read/write/edit/glob/grep) get a hard deny
  // outside /tmp/opencode; no prompt, no silent-allow fallback (fail mode is
  // the catch-all `ask`). Last-match-wins: catch-all first, denies, allows last.
  // The same chain repeats under plan/explore/general — their old
  // `external_directory: "allow"` scalar would otherwise override this block.
  // Session derivation propagates external_directory + deny rules to subagents,
  // so new agents inherit the chain unless they declare external_directory.
  // Bash redirects/side-effect writes bypass this (advisory extractor, #18396).
  // Secrets denylist: global read/edit chains deny ssh, gnupg, aws,
  // gopass, password-store, kube, gcloud (read = exfil, edit = overwrite).
  // read/edit match WORKTREE-RELATIVE paths (PR #26583) while
  // external_directory matches absolute — so anchored ~/... patterns can
  // never match here; leading "*/" matches both forms ("*" crosses "/").
  // "**" is cosmetic on v1 ("*" already crosses "/"). User "read" object
  // replaces built-in defaults, so "*.env" denies are re-listed explicitly.
  //
  // SINGLE-USER ASSUMPTION (hardcoded /home/mike on purpose): config.txt
  // commits USERNAME=mike, install.py rejects any empty var, and
  // lib/helpers/common.sh:121 aborts the whole deploy if whoami != USERNAME
  // — so a non-mike account fails loud at install, never silently half-wired.
  // Precedent: ark/etc gomplate templates render {{ .Env.USERNAME }} to the
  // literal into /opt/ark. Changing USERNAME means editing these paths too.
  //
  // Bare-dir rules ("*/.ssh", no trailing slash) exist because a content
  // pattern needs >=1 char after the slash: "*/.ssh/*" does not match the
  // directory itself, and read on a directory lists it. Verified leak.
  //
  // KNOWN HOLES (parked in docs/backlog.md 005/006, not fixed here): grep
  // permissions match the regex not the file, so grep can print secret
  // contents (upstream #17073); permission matching never resolves symlinks,
  // so a symlink under /tmp/opencode reaches any secret (upstream #51347);
  // bash bypasses all of it (advisory extractor, #18396). The read/edit
  // chains are not a complete boundary — they are the cheap layer.
  //
  // Per-agent "read" scalars were deleted so all agents inherit the global
  // read chain; per-agent external_directory chains stay (roaming "*" allow
  // is intentional for subagents, global stays ask). That roaming means the
  // global external "*" ask is VOID inside plan/explore/general — agent
  // rules merge after global and win last-match — so these read/edit chains
  // are subagents' only guard. Plan keeps edit/write deny, which overrides
  // the global edit chain per-key.
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp": "deny",
      "/tmp/*": "deny",
      "/tmp/**": "deny",
      "/tmp/opencode": "allow",
      "/tmp/opencode/*": "allow",
      "/tmp/opencode/**": "allow"
    },
    // Secrets denylist (second layer): plan/explore/general roam with
    // external "*" allow, so without this they could read secrets silently.
    // read = exfil vector; edit = authorized_keys-overwrite vector (#18396
    // pattern). "*" first per last-match-wins; matches previous defaults.
    // Per secret dir, three rules: bare dir, hardcoded dir, dir contents.
    // The "*/" forms are what enforce (see header); the /home/mike/... pair
    // makes the single-user assumption legible in-file (see header).
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "*.env.example": "allow",
      "*/.ssh": "deny",
      "/home/mike/.ssh": "deny",
      "*/.ssh/*": "deny",
      "*/.gnupg": "deny",
      "/home/mike/.gnupg": "deny",
      "*/.gnupg/*": "deny",
      "*/.aws": "deny",
      "/home/mike/.aws": "deny",
      "*/.aws/*": "deny",
      "*/.config/gopass": "deny",
      "/home/mike/.config/gopass": "deny",
      "*/.config/gopass/*": "deny",
      "*/.password-store": "deny",
      "/home/mike/.password-store": "deny",
      "*/.password-store/*": "deny",
      "*/.kube": "deny",
      "/home/mike/.kube": "deny",
      "*/.kube/*": "deny",
      "*/.config/gcloud": "deny",
      "/home/mike/.config/gcloud": "deny",
      "*/.config/gcloud/*": "deny"
    },
    // "*.envrc" is denied here too (unlike the other .env rules): direnv
    // sources .envrc as shell code on cd, so writing one is code execution,
    // strictly worse than reading one.
    "edit": {
      "*": "allow",
      "*.envrc": "deny",
      "*/.ssh": "deny",
      "/home/mike/.ssh": "deny",
      "*/.ssh/*": "deny",
      "*/.gnupg": "deny",
      "/home/mike/.gnupg": "deny",
      "*/.gnupg/*": "deny",
      "*/.aws": "deny",
      "/home/mike/.aws": "deny",
      "*/.aws/*": "deny",
      "*/.config/gopass": "deny",
      "/home/mike/.config/gopass": "deny",
      "*/.config/gopass/*": "deny",
      "*/.password-store": "deny",
      "/home/mike/.password-store": "deny",
      "*/.password-store/*": "deny",
      "*/.kube": "deny",
      "/home/mike/.kube": "deny",
      "*/.kube/*": "deny",
      "*/.config/gcloud": "deny",
      "/home/mike/.config/gcloud": "deny",
      "*/.config/gcloud/*": "deny"
    }
  },
  "agent": {
    "plan": {
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "external_directory": {
          "*": "allow",
          "/tmp": "deny",
          "/tmp/*": "deny",
          "/tmp/**": "deny",
          "/tmp/opencode": "allow",
          "/tmp/opencode/*": "allow",
          "/tmp/opencode/**": "allow"
        }
      }
    },
    "explore": {
      "mode": "subagent",
        "temperature": 0.5,
        "permission": {
          "external_directory": {
            "*": "allow",
            "/tmp": "deny",
            "/tmp/*": "deny",
            "/tmp/**": "deny",
            "/tmp/opencode": "allow",
            "/tmp/opencode/*": "allow",
            "/tmp/opencode/**": "allow"
          }
        }
    },
    "general": {
      "mode": "subagent",
        "temperature": 0.3,
        "permission": {
          "external_directory": {
            "*": "allow",
            "/tmp": "deny",
            "/tmp/*": "deny",
            "/tmp/**": "deny",
            "/tmp/opencode": "allow",
            "/tmp/opencode/*": "allow",
            "/tmp/opencode/**": "allow"
          }
        }
    },
    // 1M compaction model matches the session window — auto-compaction safe.
    "compaction": {
      "model": "kilo/nvidia/nemotron-3.5-lightning:free"
    }
  },
  "lsp": {
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "pyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "basedpyright.analysis": {
          "typeCheckingMode": "standard"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  // API-key precedence: config `options.apiKey` beats auth.json (~/.local/share/opencode/auth.json).
  // `{env:VAR}` resolves to "" when unset — and "" is not `undefined`, so opencode will
  // NOT fall back to the TUI-stored key. TUI-managed providers (atria, dahl): omit `apiKey`,
  // add key via /connect after reload; stored in auth.json, never in git.
  "provider": {
    "opencode": {
      "models": {
        "big-pickle": {
          "options": {
            "temperature": 0.3
          }
        },
        "muse-spark-1.3-contributor-free": {
          "options": {
            "temperature": 0.3
          }
        }
      }
    },
    "atria": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Atria ASI",
      "options": {
        "baseURL": "https://api.atria-asi.ai/v1",
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 2000,
          "maxTimeout": 10000
        }
        // Free pool: 100M tokens one-time per account (console observation 2026-09-16, unpublished publicly).
      },
      "whitelist": [
        "atria-dawn-preview"
      ],
      "models": {
        "atria-dawn-preview": {
          "name": "Atria Dawn Preview (256K)",
          "limit": {
            "context": 256000,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "Atria-Dawn-Preview",
            "temperature": 0.3
          }
        }
      }
    },

    "dahl": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Dahl Inference",
      "options": {
        "baseURL": "https://inference.dahl.global/v1",
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 2000,
          "maxTimeout": 10000
        }
        // Free pool: 100M tokens/key, renewable via new key; live IDs from GET /v1/models.
      },
      "whitelist": [
        "deepseek-v4-flash-0731"
      ],
      "models": {
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash (400K)",
          "limit": {
            "context": 400000,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "deepseek-ai/DeepSeek-V4-Flash-0731",
            "temperature": 0.3
          }
        }
      }
    },


    "inception": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Inception Labs",
      "options": {
        "baseURL": "https://api.inceptionlabs.ai/v1",
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 2000,
          "maxTimeout": 10000
        }
        // Free pool: 100M tokens/account per docs (models page notes 10M per new key); repo cost 0/0.
      },
      "whitelist": [
        "mercury-2.5"
      ],
      "models": {
        "mercury-2.5": {
          "name": "Mercury 2.5 (260K)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 260000,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "mercury-2.5",
            "temperature": 0.3
          }
        }
      }
    },

    "radeon": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AMD Radeon TokenFactory",
      "options": {
        "baseURL": "https://developer.amd.com.cn/radeon/api/v1",
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 2000,
          "maxTimeout": 10000
        }
      },
      "whitelist": [
        "DeepSeek-V4-Flash"
      ],
      "models": {
        "DeepSeek-V4-Flash": {
          "name": "DeepSeek V4 Flash (1M)",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "temperature": 0.3
          }
        }
      }
    },

    "kilo": {
      "whitelist": [
        "nvidia/nemotron-3-super-120b-a12b:free",
        "stepfun/step-3.7-flash:free",
        "nvidia/nemotron-3.5-lightning:free"
      ],
      "models": {

        "nvidia/nemotron-3-super-120b-a12b:free": {
          "name": "NVIDIA Nemotron 3 Super 120B (262K)",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "nvidia/nemotron-3-super-120b-a12b:free",
            "temperature": 0.3
          }
        },
        "stepfun/step-3.7-flash:free": {
          "name": "StepFun Step 3.7 Flash (262K)",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "stepfun/step-3.7-flash:free",
            "temperature": 0.3
          }
        },
        "nvidia/nemotron-3.5-lightning:free": {
          "name": "NVIDIA Nemotron 3.5 Lightning (1M)",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "nvidia/nemotron-3.5-lightning:free",
            "temperature": 0.3
          }
        }
      }
    }
  }
}
