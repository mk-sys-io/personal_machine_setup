{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "opencode/mimo-v2.5-free"
    },
    "plan": {
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "edit": "deny",
        "write": "deny",
        "external_directory": "allow"
      }
    },
    "explore": {
      "mode": "subagent",
      "temperature": 0.5,
      "permission": {
        "read": "allow",
        "external_directory": "allow"
      }
    },
    "general": {
      "mode": "subagent",
      "temperature": 0.3,
      "permission": {
        "read": "allow",
        "external_directory": "allow"
      }
    }
  },
  "lsp": {
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "pyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "basedpyright.analysis": {
          "typeCheckingMode": "standard"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "basic-memory": {
      "type": "local",
      "command": ["/home/mike/.local/bin/uvx", "basic-memory", "mcp"],
      "enabled": true
    }
  },
  "provider": {
    "opencode": {
      "models": {
        "big-pickle": {
          "options": {
            "temperature": 0.3
          }
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 1000,
          "maxTimeout": 10000
        }
      },
      "whitelist": [
        "openai/gpt-oss-120b",
        "openai/gpt-oss-20b",
        "nvidia/llama-3.3-nemotron-super-49b-v1.5"
      ],
      "models": {
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B",
          "limit": {
            "context": 128000,
            "output": 4096
          },
          "options": {
            "temperature": 0.3
          }
        },
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B",
          "limit": {
            "context": 128000,
            "output": 4096
          },
          "options": {
            "temperature": 0.2
          }
        },
        "nvidia/llama-3.3-nemotron-super-49b-v1.5": {
          "name": "Llama 3.3 Nemotron Super 49B",
          "limit": {
            "context": 131072,
            "output": 65536
          },
          "options": {
            "temperature": 0.3
          }
        }
      }
    },

    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.ai GLM",
      "options": {
        "baseURL": "https://api.z.ai/api/paas/v4",
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 1000,
          "maxTimeout": 10000
        }
      },
      "whitelist": [
        "glm-4.7-flash",
        "glm-4.5-flash"
      ],
      "models": {
        "glm-4.7-flash": {
          "name": "GLM-4.7 Flash",
          "limit": {
            "context": 200000,
            "output": 131072
          },
          "options": {
            "temperature": 0.3
          }
        },
        "glm-4.5-flash": {
          "name": "GLM-4.5 Flash",
          "limit": {
            "context": 131072,
            "output": 98304
          },
          "options": {
            "temperature": 0.3
          }
        }
      }
    }
  }
}
