{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "opencode/big-pickle"
    },
    "plan": {
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "edit": "deny",
        "write": "deny",
        "external_directory": "allow"
      }
    },
    "explore": {
      "mode": "subagent",
      "temperature": 0.5,
      "permission": {
        "read": "allow",
        "external_directory": "allow"
      }
    },
    "general": {
      "mode": "subagent",
      "temperature": 0.3,
      "permission": {
        "read": "allow",
        "external_directory": "allow"
      }
    }
  },
  "lsp": {
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "pyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "basedpyright.analysis": {
          "typeCheckingMode": "standard"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "basic-memory": {
      "type": "local",
      "command": ["/home/mike/.local/bin/uvx", "basic-memory", "mcp"],
      "enabled": true
    }
  },
  // API-key precedence: config `options.apiKey` beats auth.json (~/.local/share/opencode/auth.json).
  // `{env:VAR}` resolves to "" when unset — and "" is not `undefined`, so opencode will
  // NOT fall back to the TUI-stored key. TUI-managed providers (atria, dahl): omit `apiKey`,
  // add key via /connect after reload; stored in auth.json, never in git.
  "provider": {
    "opencode": {
      "models": {
        "big-pickle": {
          "options": {
            "temperature": 0.3
          }
        }
      }
    },
    "atria": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Atria ASI",
      "options": {
        "baseURL": "https://api.atria-asi.ai/v1",
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 2000,
          "maxTimeout": 10000
        }
        // Free pool: 100M tokens one-time per account (console observation 2026-09-16, unpublished publicly).
      },
      "whitelist": [
        "atria-dawn-preview"
      ],
      "models": {
        "atria-dawn-preview": {
          "name": "Atria Dawn Preview (256K)",
          "limit": {
            "context": 256000,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "Atria-Dawn-Preview",
            "temperature": 0.3
          }
        }
      }
    },

    "dahl": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Dahl Inference",
      "options": {
        "baseURL": "https://inference.dahl.global/v1",
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 2000,
          "maxTimeout": 10000
        }
        // Free pool: 100M tokens/key, renewable via new key; live IDs from GET /v1/models.
      },
      "whitelist": [
        "minimax-m2.7",
        "deepseek-v4-flash-0731",
        "glm-5.3-flash"
      ],
      "models": {
        "minimax-m2.7": {
          "name": "MiniMax M2.7 (180K)",
          "reasoning": true,
          "tool_call": true,
          "interleaved": "reasoning_content",
          "limit": {
            "context": 180000,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "MiniMaxAI/MiniMax-M2.7",
            "temperature": 1.0
          }
        },
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash (400K)",
          "limit": {
            "context": 400000,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "deepseek-ai/DeepSeek-V4-Flash-0731",
            "temperature": 0.3
          }
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash (400K)",
          "limit": {
            "context": 400000,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "zai-org/GLM-5.3-Flash",
            "temperature": 0.3
          }
        }
      }
    },

    "tokenharbor": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Token Harbor",
      "options": {
        "baseURL": "https://tokenharbor.ai/v1",
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 2000,
          "maxTimeout": 10000
        }
      },
      "whitelist": [
        "deepseek-v4.1-flash:free",
        "mimo-v2.6-flash:free"
      ],
      "models": {
        "deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash Free (1M)",
          "limit": {
            "context": 1048576,
            "output": 128000
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "deepseek-v4.1-flash:free",
            "temperature": 1.0
          }
        },
        "mimo-v2.6-flash:free": {
          "name": "MiMo V2.6 Flash Free (1M)",
          "limit": {
            "context": 1048576,
            "output": 128000
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "mimo-v2.6-flash:free",
            "temperature": 1.0
          }
        }
      }
    },

    "inception": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Inception Labs",
      "options": {
        "baseURL": "https://api.inceptionlabs.ai/v1",
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 2000,
          "maxTimeout": 10000
        }
        // Free pool: 100M tokens/account per docs (models page notes 10M per new key); repo cost 0/0.
      },
      "whitelist": [
        "mercury-2.5"
      ],
      "models": {
        "mercury-2.5": {
          "name": "Mercury 2.5 (260K)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 260000,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "mercury-2.5",
            "temperature": 0.3
          }
        }
      }
    },

    "kilo": {
      "whitelist": [
        "cohere/north-mini-code:free",
        "nvidia/nemotron-3-super-120b-a12b:free",
        "stepfun/step-3.7-flash:free"
      ],
      "models": {
        "cohere/north-mini-code:free": {
          "name": "Cohere North Mini Code (256K)",
          "limit": {
            "context": 256000,
            "output": 64000
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "cohere/north-mini-code:free",
            "temperature": 0.3
          }
        },
        "nvidia/nemotron-3-super-120b-a12b:free": {
          "name": "NVIDIA Nemotron 3 Super 120B (262K)",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "nvidia/nemotron-3-super-120b-a12b:free",
            "temperature": 0.3
          }
        },
        "stepfun/step-3.7-flash:free": {
          "name": "StepFun Step 3.7 Flash (262K)",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "stepfun/step-3.7-flash:free",
            "temperature": 0.3
          }
        }
      }
    }
  }
}
