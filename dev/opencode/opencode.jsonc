{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "edit": "deny",
        "write": "deny",
        "external_directory": "allow"
      }
    },
    "explore": {
      "mode": "subagent",
      "temperature": 0.5,
      "permission": {
        "read": "allow",
        "external_directory": "allow"
      }
    },
    "general": {
      "mode": "subagent",
      "temperature": 0.3,
      "permission": {
        "read": "allow",
        "external_directory": "allow"
      }
    }
  },
  "command": {
    "proceed": {
      "description": "Execute agreed changes or a plan file, then list all modifications",
      "agent": "build",
      "template": "$ARGUMENTS\n\nIf a plan file path was provided above, read that file and execute the changes described in it. If no file path was provided, execute the changes agreed upon in our conversation.\n\nStick strictly to the agreed scope — do not modify anything outside of it. If there are no agreed changes and no plan file was provided, stop and state that there is nothing to proceed on.\n\nArguments after /proceed may specify:\n- A plan file to execute\n- Specific changes to focus on\n- Changes to skip or ignore\n- Custom instructions or context\n\nPrioritize these additional instructions.\n\nBefore making any changes, use the todowrite tool to create a task list with one item per logical change. Check off each item as you complete it.\n\nAfter completing all changes, present the final todo list as your report — every file that was modified, created, or deleted."
    },
    "init": {
      "description": "Seed Basic Memory with codebase structure for a new project",
      "agent": "build",
      "template": "You are initializing Basic Memory for this project.\n\n1. Call `search_notes` with this repo name and key terms. If meaningful results exist, summarize what's already known and stop — memory is already seeded.\n\n2. If memory is empty, explore the codebase:\n   - Top-level file listing, README, package.json, tsconfig, any docs/ or GUIDELINES\n   - Entrypoints, main src/ structure, key modules (depth: ~3 levels, not every file)\n   - Any existing configuration files, CI setup, test structure\n   - Use `context7` to fetch docs for any major frameworks/libraries used\n\n3. Write structured notes via `write_note`:\n   - One architecture note: module layout, entrypoints, dependency flow, build commands\n   - One conventions note: naming, patterns, testing approach, lint rules\n   - Key config files summary (list what they control)\n\n4. Print a summary of what was stored.\n\nScope: informative, not exhaustive. ~15-30 files max. Skip node_modules, .git, build artifacts."
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "basic-memory": {
      "type": "local",
      "command": ["/home/mike/.local/bin/uvx", "basic-memory", "mcp"],
      "enabled": true
    },
    "mcp-mermaid": {
      "type": "local",
      "command": ["npx", "-y", "mcp-mermaid"],
      "enabled": true
    }
  },
  "provider": {
    "opencode": {
      "models": {
        "big-pickle": {
          "options": {
            "temperature": 0.3
          }
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "timeout": 60000,
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 1000,
          "maxTimeout": 10000
        }
      },
      "whitelist": [
        "moonshotai/kimi-k2.6",
        "mistralai/mistral-large-3-675b-instruct-2512",
        "mistralai/mistral-small-4-119b-2603",
        "openai/gpt-oss-120b",
        "openai/gpt-oss-20b",
        "z-ai/glm-5.2"
      ],
      "models": {
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B",
          "options": {
            "temperature": 0.3
          }
        },
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B",
          "options": {
            "temperature": 0.2
          }
        },
        "moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6",
          "options": {
            "temperature": 0.3
          }
        },
        "mistralai/mistral-large-3-675b-instruct-2512": {
          "name": "Mistral Large 3 675B",
          "options": {
            "temperature": 0.5
          }
        },
        "mistralai/mistral-small-4-119b-2603": {
          "name": "Mistral Small 4 119B",
          "options": {
            "temperature": 0.3
          }
        },
        "z-ai/glm-5.2": {
          "name": "GLM-5.2",
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "options": {
            "temperature": 0.3
          }
        }
      }
    },

    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.ai GLM",
      "options": {
        "baseURL": "https://api.z.ai/api/paas/v4",
        "timeout": 60000,
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 1000,
          "maxTimeout": 10000
        }
      },
      "whitelist": [
        "glm-4.7-flash",
        "glm-4.5-flash"
      ],
      "models": {
        "glm-4.7-flash": {
          "name": "GLM-4.7 Flash",
          "limit": {
            "context": 200000,
            "output": 131072
          },
          "options": {
            "temperature": 0.3
          }
        },
        "glm-4.5-flash": {
          "name": "GLM-4.5 Flash",
          "limit": {
            "context": 131072,
            "output": 98304
          },
          "options": {
            "temperature": 0.3
          }
        }
      }
    }
  }
}
