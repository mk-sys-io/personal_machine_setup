{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "opencode/big-pickle"
    },
    "plan": {
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "edit": "deny",
        "write": "deny",
        "external_directory": "allow"
      }
    },
    "explore": {
      "mode": "subagent",
      "temperature": 0.5,
      "permission": {
        "read": "allow",
        "external_directory": "allow"
      }
    },
    "general": {
      "mode": "subagent",
      "temperature": 0.3,
      "permission": {
        "read": "allow",
        "external_directory": "allow"
      }
    }
  },
  "lsp": {
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "pyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "basedpyright.analysis": {
          "typeCheckingMode": "standard"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "basic-memory": {
      "type": "local",
      "command": ["/home/mike/.local/bin/uvx", "basic-memory", "mcp"],
      "enabled": true
    }
  },
  // API-key precedence: config `options.apiKey` beats auth.json (~/.local/share/opencode/auth.json).
  // `{env:VAR}` resolves to "" when the var is unset — and "" is not `undefined`, so opencode will
  // NOT fall back to the TUI-stored key. To use TUI-managed keys, omit `apiKey` (see atria).
  "provider": {
    "opencode": {
      "models": {
        "big-pickle": {
          "options": {
            "temperature": 0.3
          }
        }
      }
    },
    "atria": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Atria ASI",
      "options": {
        "baseURL": "https://api.atria-asi.ai/v1",
        "retry": {
          "maxAttempts": 3,
          "minTimeout": 2000,
          "maxTimeout": 10000
        }
        // Auth: TUI-managed only (no apiKey field by design).
        // Add key via /connect after reload; stored in ~/.local/share/opencode/auth.json, never in git.
        // Free pool: 100M tokens one-time per account (console observation 2026-09-16, unpublished publicly).
      },
      "whitelist": [
        "atria-dawn-preview"
      ],
      "models": {
        "atria-dawn-preview": {
          "name": "Atria Dawn Preview (256K)",
          "limit": {
            "context": 256000,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "Atria-Dawn-Preview",
            "temperature": 0.3
          }
        }
      }
    },

    "kilo": {
      "whitelist": [
        "cohere/north-mini-code:free",
        "nvidia/nemotron-3-super-120b-a12b:free",
        "stepfun/step-3.7-flash:free",
        "nvidia/nemotron-3.5-lightning:free"
      ],
      "models": {
        "cohere/north-mini-code:free": {
          "name": "Cohere North Mini Code (256K)",
          "limit": {
            "context": 256000,
            "output": 64000
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "cohere/north-mini-code:free",
            "temperature": 0.3
          }
        },
        "nvidia/nemotron-3-super-120b-a12b:free": {
          "name": "NVIDIA Nemotron 3 Super 120B (262K)",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "nvidia/nemotron-3-super-120b-a12b:free",
            "temperature": 0.3
          }
        },
        "stepfun/step-3.7-flash:free": {
          "name": "StepFun Step 3.7 Flash (262K)",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "stepfun/step-3.7-flash:free",
            "temperature": 0.3
          }
        },
        "nvidia/nemotron-3.5-lightning:free": {
          "name": "NVIDIA Nemotron 3.5 Lightning (262K)",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "options": {
            "model": "nvidia/nemotron-3.5-lightning:free",
            "temperature": 0.3
          }
        }
      }
    }
  }
}
