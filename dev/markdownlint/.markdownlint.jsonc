  "MD042": "error",
  "MD051": "error",
  "MD052": "error",
  "MD053": "error",
  "MD056": "error",
  "MD058": "error",

  "MD003": "warning",
  "MD004": "warning",
  "MD007": "warning",
  "MD009": "warning",
  "MD010": { "severity": "warning", "code_blocks": false },
