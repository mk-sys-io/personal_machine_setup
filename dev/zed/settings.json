{
  "theme": "One Dark Pro",
  "buffer_font_size": 17.25,
  "ui_font_size": 17.25,
  "icon_theme": "Material Icon Theme",
  "project_panel": {
    "drag_and_drop": false
  },
  "auto_install_extensions": {
    "git-firefly": true,
    "make": true,
    "one-dark-pro": true,
    "material-icon-theme": true,
    "toml": true,
    "tombi": true
  },
  "soft_wrap": "editor_width",
  "theme_overrides": {
    "One Dark Pro": {
      "created": "#7ec699",
      "created.background": "#7ec69918",
      "created.border": "#3a5c4a",
      "modified": "#e5c07b",
      "modified.background": "#e5c07b18",
      "modified.border": "#5c4a2a",
      "deleted": "#e06c75",
      "deleted.background": "#e06c7518",
      "deleted.border": "#5c2a2d",
      "renamed": "#61afef",
      "renamed.background": "#61afef18",
      "renamed.border": "#2a3d5c",
      "ignored": "#636b78",
      "ignored.background": "#636b7810",
      "ignored.border": "#3e4452"
    }
  }
}
