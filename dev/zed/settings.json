{
  "theme": "One Dark Pro",
  "buffer_font_size": 17.25,
  "ui_font_size": 17.25,
  "icon_theme": "Material Icon Theme",
  "project_panel": {
    "drag_and_drop": false,
    "hide_gitignore": false,
    "hide_hidden": false
  },
  "focus_follows_mouse": {
    "enabled": true,
    "debounce_ms": 250
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/__pycache__",
    "**/*.py[cod]",
    "**/*$py.class",
    "**/*.so",
    "**/.hypothesis",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.mypy_cache",
    "**/.dmypy.json",
    "**/dmypy.json",
    "**/.pytype",
    "**/.pyre",
    "**/.venv",
    "**/venv",
    "**/env",
    "**/ENV",
    "**/env.bak",
    "**/venv.bak",
    "**/.direnv",
    "**/.eggs",
    "**/eggs",
    "**/__pypackages__",
    "**/.nox",
    "**/.tox",
    "**/.pants.d",
    "**/site-packages",
    "**/build",
    "**/dist",
    "**/sdist",
    "**/wheels",
    "**/*.egg-info",
    "**/*.egg",
    "**/develop-eggs",
    "**/_build",
    "**/buck-out",
    "**/htmlcov",
    "**/.coverage",
    "**/.coverage.*",
    "**/.cache",
    "**/pip-log.txt",
    "**/.ipynb_checkpoints",
    "**/node_modules",
    "**/jspm_packages",
    "**/.next",
    "**/.nuxt",
    "**/.turbo",
    "**/.parcel-cache",
    "**/.vite",
    "**/coverage",
    "**/.nyc_output",
    "**/.tap",
    "**/report",
    "**/.eslintcache",
    "**/.stylelintcache",
    "**/vendor",
    "**/target",
    "**/out",
    "**/bin",
    "**/.gradle",
    "**/.vscode",
    "**/.vscode-test",
    "**/.idea",
    "**/desktop.ini"
  ],
  "auto_install_extensions": {
    "git-firefly": true,
    "make": true,
    "one-dark-pro": true,
    "material-icon-theme": true,
    "toml": true,
    "tombi": true
  },
  "soft_wrap": "editor_width",
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-language-server", "!vtsls"],
      "prettier": { "allowed": true }
    },
    "TSX": {
      "language_servers": ["typescript-language-server", "!vtsls"],
      "prettier": { "allowed": true }
    },
    "JavaScript": {
      "language_servers": ["typescript-language-server", "!vtsls"],
      "prettier": { "allowed": true }
    }
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          // Switch to "strict" once all Python scripts are fully annotated
          "typeCheckingMode": "standard",
          "diagnosticMode": "workspace",
          "inlayHints": {
            "callArgumentNames": true,
            "variableTypes": true
          }
        }
      }
    },
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayParameterNameHintsWhenArgumentMatchesName": true,
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": true,
          "includeInlayVariableTypeHintsWhenTypeMatchesName": true,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayEnumMemberValueHints": true
        }
      }
    }
  },
  "theme_overrides": {
    "One Dark Pro": {
      "created": "#7ec699",
      "created.background": "#7ec69918",
      "created.border": "#3a5c4a",
      "modified": "#e5c07b",
      "modified.background": "#e5c07b18",
      "modified.border": "#5c4a2a",
      "deleted": "#e06c75",
      "deleted.background": "#e06c7518",
      "deleted.border": "#5c2a2d",
      "renamed": "#61afef",
      "renamed.background": "#61afef18",
      "renamed.border": "#2a3d5c",
      "ignored": "#636b78",
      "ignored.background": "#636b7810",
      "ignored.border": "#3e4452"
    }
  }
}
