#!/bin/sh
# Global pre-commit hook — secret scanning via gitleaks
# Deployed by linux_setup to ~/.git-hooks/pre-commit.
# -c pins the machine-wide shared config (deployed by
# lib/50-github_setup.sh from the repo .gitleaks.toml), so every repo —
# including the gopass secret store — scans under one versioned policy
# instead of per-repo files.
gitleaks protect --staged --verbose --redact -c "$HOME/.config/gitleaks/gitleaks.toml"
