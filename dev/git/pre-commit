#!/bin/bash
# Global pre-commit hook — gitleaks secrets, then TS/JS format+lint, then
# Python format+lint, then Markdown, then TS/JS + Python typecheck.
# Human/commit backstop, not an agent guardrail: the only automatic type
# gates are this hook's tsc/basedpyright runs, and they fire only on commit.
# Deployed by `make dev` from dev/git/pre-commit to ~/.git-hooks/pre-commit
# (only when the gitleaks binary is present — an unrunnable hook would block
# every commit). Fail-open when a binary is absent.
# -c pins the machine-wide shared config (deployed by `make dev` from
# dev/git/gitleaks.toml), so every repo scans under one versioned policy
# instead of per-repo files.
gitleaks protect --staged --verbose --redact -c "$HOME/.config/gitleaks/gitleaks.toml" || exit 1

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
tmpfile=$(mktemp) || exit 0
py_tmpfile=$(mktemp) || exit 0
trap 'rm -f "$tmpfile" "$py_tmpfile"' EXIT HUP INT TERM

# Collect staged TS/JS/JSON files as absolute paths (NUL-separated). biome then
# runs from the repo root, so the repo/global policy resolves normally.
git diff --cached --name-only -z --diff-filter=ACMR \
  | grep -zE '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs|json|jsonc)$' \
  | while IFS= read -r -d '' f; do printf '%s/%s\0' "$repo_root" "$f"; done > "$tmpfile"

if command -v biome >/dev/null 2>&1 && [ -s "$tmpfile" ]; then
  # Run from the repo root (hooks already run there): biome resolves the
  # project root from cwd, so the repo config or config-home default applies.
  xargs -0 biome check --write --no-errors-on-unmatched < "$tmpfile" || exit 1
  xargs -0 git add < "$tmpfile"
fi

# Python: ruff lint + format on staged files (mutating ladder step 1-2).
git diff --cached --name-only -z --diff-filter=ACMR \
  | grep -zE '\.(py|pyi|ipynb)$' \
  | while IFS= read -r -d '' f; do printf '%s/%s\0' "$repo_root" "$f"; done > "$py_tmpfile"

if command -v ruff >/dev/null 2>&1 && [ -s "$py_tmpfile" ]; then
  xargs -0 ruff check --fix -- < "$py_tmpfile" || exit 1
  xargs -0 ruff format -- < "$py_tmpfile" || exit 1
  xargs -0 git add -- < "$py_tmpfile"
fi

# Markdown: staged files only; shared rules-only config; pinned linter.
# A repo-local config may override explicit keys (base semantics), but
# --no-globs stops its globs from expanding to the whole tree.
md_files=()
mapfile -d '' md_files < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.md')
if ((${#md_files[@]} > 0)); then
  md_config="$HOME/.config/markdownlint/.markdownlint.jsonc"
  if [ -f "$md_config" ] && command -v npx >/dev/null 2>&1; then
    npx --yes markdownlint-cli2@0.24.2 --no-globs --config "$md_config" -- "${md_files[@]}" || exit 1
  else
    echo "warning: markdownlint skipped (missing $md_config or npx)." >&2
  fi
fi

# Typecheck only when the checkout is actually installed (otherwise module
# resolution fails on every import and blocks unrelated commits). Repos with
# no package.json are assumed dependency-free and still checked.
if [ -f tsconfig.json ] && command -v tsc >/dev/null 2>&1 \
   && { [ -d node_modules ] || [ -e .pnp.cjs ] || [ ! -f package.json ]; }
then
  tsc --noEmit -p . || exit 1
fi

# Python typecheck only when a project config exists (mirrors tsc). With no
# config, basedpyright falls back to recommended mode and would run on every
# repo, so gate it on an explicit config like tsc.
if command -v basedpyright >/dev/null 2>&1 \
   && { [ -f pyrightconfig.json ] \
        || grep -qE '^[[:space:]]*\[tool\.(pyright|basedpyright)\]' pyproject.toml 2>/dev/null; }
then
  basedpyright || exit 1
fi