<!-- vm/domain.xml.template — libvirt domain template for the staging VM
     Placeholders: {vm_name}, {memory}, {vcpu}, {disk_path}, {virtiofs_dir}, {mount_tag} -->
<domain type='kvm'>
  <name>{vm_name}</name>
  <memory unit='GiB'>{memory}</memory>
  <memoryBacking>
    <source type='memfd'/>
    <access mode='shared'/>
  </memoryBacking>
  <vcpu placement='static'>{vcpu}</vcpu>
  <os firmware='efi'>
    <type arch='x86_64' machine='pc-q35-9.0'>hvm</type>
    <firmware>
      <feature name='secure-boot' enabled='no'/>
    </firmware>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='{disk_path}'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs'/>
      <source dir='{virtiofs_dir}'/>
      <target dir='{mount_tag}'/>
    </filesystem>
    <graphics type='spice' autoport='yes'/>
    <video>
      <model type='virtio'/>
    </video>
    <interface type='network'>
      <source network='default'/>
      <model type='virtio'/>
    </interface>
    <serial type='pty'>
      <target port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <channel type='unix'>
      <source mode='bind'/>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>
  </devices>
</domain>
