# ── Identity ──
USERNAME=
USER_UID=
USER_GID=

# ── Paths ──
OPENCODE_PATH=
OBSIDIAN_VAULT_PATH=

# ── Default app ──
TERMINAL=

# ── Gomplate render paths ──
ARK_RENDER_PATHS="/opt/ark /usr/local/bin /usr/local/lib/ark /etc/sudoers.d /etc/polkit-1/rules.d /etc/systemd/system /etc/netns/internet-netns /etc/nftables.conf"

# ── Ark paths ──
ARK_DATA_PATH=/opt/ark
ARK_LIB_PATH=/usr/local/lib/ark
ARK_BIN_PATH=/usr/local/bin
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=2606:4700:4700::1111
NETNS_SUBNET=10.0.4.0/30
NETNS_HOST=10.0.4.1
NETNS_CLIENT=10.0.4.2

# ── Blocklist ──
# StevenBlack: ads, malware, fake news, gambling (~174K domains)
# Bon-Appetit: porn/aggregated from 20+ sources (~304K domains)
BLOCKLIST_URLS="https://raw.githubusercontent.com/StevenBlack/hosts/master/alternates/fakenews-gambling-porn/hosts https://raw.githubusercontent.com/Bon-Appetit/porn-domains/main/block.a4779101ab.0d93sm.txt"

# ── Timelock (tle) ──
TLE_PRIMARY_PATH=/usr/local/bin/tle
TLE_FALLBACK_PATH=/home/mike/go/bin/tle
TLE_TIMEOUT=300

# ── Drand timelock network ──
DRAND_HOST=api.drand.sh
DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971

# ── Testing ──
DNS_TEST_DOMAIN=snapchat.com

# ── Browser/history cleanup ──
BROWSER_CONFIG_DIRS="BraveSoftware/Brave-Browser google-chrome chromium"
SHELL_HISTORY_FILES=".bash_history .zsh_history .zhistory"

# ── Gtr (git worktree manager) ──
GTR_AI_DEFAULT=opencode
GTR_EDITOR_DEFAULT="zed -r"

# ── DNS listener ──
DNSMASQ_LISTEN_ADDR=127.0.0.1
DNSMASQ_LISTEN_PORT=53
DNS_HEALTH_TIMEOUT=3
DNS_HEALTH_DELAY=1

# ── Firewall ──
NFTABLES_CONF_PATH=/etc/nftables.conf
NFT_DNS_PORTS=53,853

# ── Network namespace ──
NETNS_NAME=internet-netns
NETNS_VETH_HOST=veth-inet-host
NETNS_VETH_NS=veth-inet-ns
NETNS_KEEPALIVE_TIME=60
NETNS_KEEPALIVE_INTVL=10
NETNS_KEEPALIVE_PROBES=3

# ── Services ──
DNSMASQ_SERVICE=dnsmasq
NFTABLES_SERVICE=nftables

# ── Browser policies ──
BRAVE_POLICY_PATH=/etc/brave/policies/managed/policy.json
FIREFOX_POLICY_PATH=/etc/firefox/policies/policies.json
CHROMIUM_POLICY_PATH=/etc/chromium/policies/managed/policy.json
CHROME_POLICY_PATH=/etc/opt/chrome/policies/managed/policy.json

# ── Blocklist ──
BLOCKLIST_BATCH_SIZE=100000
BLOCKLIST_DOWNLOAD_TIMEOUT=60
BLOCKLIST_USER_AGENT=netmgr/1.0
BLOCKLIST_OUTPUT_FORMAT=dnsmasq

# ── Timeouts ──
SUBPROCESS_TIMEOUT=300

# ── System DNS ──
RESOLV_CONF_PATH=/etc/resolv.conf
NETWORK_MANAGER_DNS_CONF=/etc/NetworkManager/conf.d/90-dns-none.conf
PODMAN_DNS_CONF=/etc/containers/containers.conf
