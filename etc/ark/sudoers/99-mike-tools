# {{ .Env.USERNAME }} — restricted tools only (no full sudo)
# Installed by linux_setup/install.sh
# See docs/root_ownership_inventory.md for the full ark architecture

# System updates
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/apt update
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/apt upgrade
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/apt install --reinstall *

# Service status (read-only — no start/stop/restart)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/systemctl status *
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/systemctl is-active *
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/systemctl is-enabled *
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/systemctl list-units *

# Logs
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/journalctl *

# System control (reboot/poweroff/suspend)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/systemctl reboot
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /sbin/reboot
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/systemctl suspend

# Network service recovery (cask/uncask WiFi dependency)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/systemctl restart NetworkManager
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/systemctl restart dnsmasq
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/systemctl restart nftables

# Interface recovery (WiFi stuck after suspend/AX201 crash)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/sbin/ip link set *

# Firewall inspection (read-only — diagnose blocked recovery traffic)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/sbin/nft list *

# WiFi radio kill-switch (unblock after soft-block)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/sbin/rfkill

# Kernel log (WiFi/driver firmware errors per troubleshooting.md)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/dmesg

# Immutable-flag wrapper (chattr via whitelisted paths only — replaces the
# blanket /usr/bin/chattr rule)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: {{ .Env.ARK_DATA_PATH }}/scripts/immutable.sh *

# Clipboard tools — run as self to clear history under Wayland
{{ .Env.USERNAME }} ALL=({{ .Env.USERNAME }}) NOPASSWD: /usr/bin/wl-copy
{{ .Env.USERNAME }} ALL=({{ .Env.USERNAME }}) NOPASSWD: /usr/local/bin/clipse

# Internet network namespace — run approved commands with unrestricted internet
# Command allowlist enforced by netmgr, not by sudoers granularity
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/local/bin/netmgr namespace exec *

# Exec-grant management (add/remove/deploy gated by require_unrestricted —
# blocked in focused/locked; list/allowlist reads work in any mode)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/local/bin/netmgr exec-grant *

# Allowlist read (works in any mode, incl. locked — files are root:root 0640)
# No write grants: edits require full sudo AND unrestricted mode (require_unrestricted)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/local/bin/netmgr allowlist list *
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/local/bin/netmgr allowlist search *
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/local/bin/netmgr status

# Power profile switching (auto-switch on AC/battery — no polkit agent needed)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/powerprofilesctl set *

# Tools deployment (install scripts to /usr/local/bin)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/bin/install -D -m 755 /home/{{ .Env.USERNAME }}/linux_setup/tools/* /usr/local/bin/*

# Blocklist search (no sudo password needed)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/local/bin/netmgr search *

# Internet ark CLI (enable/disable/abort — NOPASSWD persists after sudo group removal)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/local/bin/ark

# Mobile cask — user-triggered; NOPASSWD persists after sudo group removal
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/local/bin/mcask

# Uncask — decrypt+display casked creds; NOPASSWD persists after sudo group
# removal (reads the root-owned cask directory, decrypts, shows plaintext)
{{ .Env.USERNAME }} ALL=(root) NOPASSWD: /usr/local/bin/uncask
