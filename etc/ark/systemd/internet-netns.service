[Unit]
Description=Internet network namespace (veth pair, routing, DNS)
Documentation=https://github.com/anomalyco/linux_setup
After=network.target nftables.service
Wants=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=python3 {{ .Env.ARK_DATA_PATH }}/scripts/netmgr.py namespace start
ExecStop=python3 {{ .Env.ARK_DATA_PATH }}/scripts/netmgr.py namespace stop

[Install]
WantedBy=multi-user.target
