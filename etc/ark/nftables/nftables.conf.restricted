#!/usr/sbin/nft -f

flush ruleset

table inet filter {
        chain input {
                type filter hook input priority filter; policy accept;
        }
        chain forward {
                type filter hook forward priority filter; policy accept;
        }
        chain output {
                type filter hook output priority filter; policy accept;

                oifname "lo" accept

                # Block VPN tunnel interfaces (Layer 3)
                oifname { "tun*", "tap*" } drop
                # wg* exempt from netns subnet (veth, not wg)
                meta nfproto ipv4 ip daddr != {{ .Env.NETNS_SUBNET }} oifname "wg*" drop
                meta nfproto ipv6 ip6 daddr != fd00::/128 oifname "wg*" drop

                skuid {{ .Env.USER_UID }} udp dport { {{ .Env.NFT_DNS_PORTS }} } drop
                skuid {{ .Env.USER_UID }} tcp dport { {{ .Env.NFT_DNS_PORTS }} } drop
        }
}

table inet nat {
        chain postrouting {
                type nat hook postrouting priority srcnat; policy accept;
                ip saddr {{ .Env.NETNS_SUBNET }} masquerade
        }
}
